# Merge these values into the external dev environment file, not into this repo.
# The default path is $HOME/dev/secrets/data-platform/.env.
AIRFLOW_UID=50000
# Set DOCKER_GID to the host Docker socket group id so DockerOperator can use
# the mounted Docker socket while Airflow runs as a non-root user.
DOCKER_GID=0

AIRFLOW_COMPOSE_PROJECT=data-platform-airflow-dev
AIRFLOW_API_PORT=8080
DATA_PLATFORM_AIRFLOW_IMAGE=data-platform-airflow:dev
DATA_PLATFORM_SCRIPTS_IMAGE=data-platform-scripts:dev
DATA_PLATFORM_DBT_IMAGE=data-platform-dbt:dev
DATA_PLATFORM_WREMOTELY_CLICKHOUSE_DBT_IMAGE=data-platform-wremotely-clickhouse-dbt:dev
DATA_PLATFORM_WREMOTELY_ETL_IMAGE=ghcr.io/<owner>/wremotely-etl:dev
# Wremotely on-prem ClickHouse runtime. Keep real passwords outside Git.
WREMOTELY_CLICKHOUSE_DATABASE=wremotely_dev
WREMOTELY_CLICKHOUSE_HOST=host.docker.internal
WREMOTELY_CLICKHOUSE_PORT=8123
WREMOTELY_CLICKHOUSE_USER=wremotely_dev
# WREMOTELY_CLICKHOUSE_PASSWORD=<external-secret>
WREMOTELY_WAREHOUSE_ROOT=/srv/data/warehouse/workmichi
WREMOTELY_CLICKHOUSE_URL=http://127.0.0.1:8123
WREMOTELY_CLICKHOUSE_TABLE_PREFIX=wremotely__landing
WREMOTELY_CLICKHOUSE_RAW_TABLE_PREFIX=wremotely__
WREMOTELY_CLICKHOUSE_TIMEOUT_SECONDS=60
WREMOTELY_PUBLICATION_SNAPSHOT_BATCH_ROW_COUNT=1000

PROJECT_ID=change-me
RAW_DATASET=raw_developername
WREMOTELY_HANDOFF_DATASET=handoff_<developer>
WREMOTELY_PUBLICATION_TOPIC=wremotely-serving-publications-<developer>
WREMOTELY_PUBLICATION_STATUS_SUBSCRIPTION=wremotely-serving-publication-status-<developer>-monitor
DBT_TARGET=dev
DBT_DATASET=dbt_<developer>
BIGQUERY_LOCATION=US
DBT_GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/dbt-service-account.json

POSTGRES_USER=airflow
# Keep this stable after the Postgres metadata volume is initialized. Changing
# it later requires recreating the local Airflow Compose volumes.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_SECRET_KEY=change-me-generate-with-python-secrets
AIRFLOW_JWT_SECRET=change-me-generate-with-python-secrets
AIRFLOW_FERNET_KEY=change-me-generate-with-fernet-command

# Optional external UI URL used by Airflow-generated links.
# AIRFLOW__API__BASE_URL=http://localhost:8080
# Optional override for long-running DockerOperator/dbt tasks. The deployed
# Compose default is 900 seconds; keep this below the task execution timeout.
# AIRFLOW__SCHEDULER__TASK_INSTANCE_HEARTBEAT_TIMEOUT=900

# Optional failure alerts. Keep webhook URLs in the external environment file.
# DATA_PLATFORM_AIRFLOW_FAILURE_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Prod-only DAG schedules.
# ETL__PERSONAL_FINANCE_SCHEDULE=0 20 * * *
# The scheduled Wremotely DAG is the ClickHouse/on-prem path.
ETL__WREMOTELY_SCHEDULE='0 */2 * * *'
# The ClickHouse lifecycle path checks one source-balanced bucket per run in
# production. Leave this unset in dev and QA, where the DAG is manual-only.
# WREMOTELY_LIFECYCLE_SCHEDULE='30 6,18 * * *'
# Production artifact cleanup runs during a quiet window and remains manual in
# dev and QA. It retains three complete days and serializes through the
# wremotely_warehouse pool.
# WREMOTELY_ARTIFACT_CLEANUP_SCHEDULE='0 3 * * *'
# The production monitor runs hourly. It is manual in dev and QA.
# WREMOTELY_MONITORING_SCHEDULE='15 * * * *'
# Optional monitor thresholds. The monitor uses these defaults when omitted.
# WREMOTELY_MONITOR_MAX_PUBLICATION_AGE_MINUTES=900
# WREMOTELY_MONITOR_MAX_ETL_SUCCESS_AGE_MINUTES=1500
# WREMOTELY_MONITOR_MAX_LIFECYCLE_SUCCESS_AGE_MINUTES=1500
# WREMOTELY_MONITOR_MAX_ARTIFACT_CLEANUP_SUCCESS_AGE_MINUTES=3000
# WREMOTELY_MONITOR_MINIMUM_FREE_PERCENT=10
# WREMOTELY_MONITOR_MINIMUM_FREE_BYTES=10737418240

# wremotely DAG runtime inputs. Keep all paths outside this repository.
WREMOTELY_ETL_GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/wremotely-etl-service-account.json
WREMOTELY_ETL_ARTIFACTS_DIR=/absolute/path/to/wremotely-etl-artifacts
# Legacy GCP-only Wremotely variables remain required while recovery DAG code
# is retained, but they are not read by the scheduled ClickHouse DAG.
WREMOTELY_DBT_JOB_CREATION_TIMEOUT_SECONDS=60
WREMOTELY_DBT_JOB_EXECUTION_TIMEOUT_SECONDS=900
WREMOTELY_PUBLICATION_HOLD_POLICY=/absolute/path/to/publication-hold-policy.md
WREMOTELY_GCS_BUCKET=change-me
WREMOTELY_GCS_PREFIX=wremotely
WREMOTELY_BIGQUERY_LOCATION=US
WREMOTELY_SOURCE_CRAWL_WORKER_COUNT=6
WREMOTELY_EXTRACT_WORKER_COUNT=4
WREMOTELY_PLATFORM_WORKER_COUNT=2
WREMOTELY_RECHECK_WORKER_COUNT=16
WREMOTELY_SOURCE_HOT_PASS_DAYS=7
WREMOTELY_LIFECYCLE_MIN_POSTING_AGE_DAYS=21
WREMOTELY_PAGE_MAX_BYTES=2097152
WREMOTELY_DOMAIN_DELAY_SECONDS=1
WREMOTELY_DOMAIN_FAILURE_LIMIT=5
WREMOTELY_CRAWL4AI_FALLBACK=auto
WREMOTELY_CRAWL4AI_MIN_TEXT_CHARS=500
WREMOTELY_STAGE_CHUNK_ROW_COUNT=5000
WREMOTELY_KNOWN_URL_LOOKBACK_DAYS=365
WREMOTELY_DOCKER_NETWORK_MODE=host
# Required only when WREMOTELY_LOCAL_LLM_RUNTIME=groq. Keep the real key outside Git.
# GROQ_API_KEY=change-me
WREMOTELY_LOCAL_LLM_RUNTIME=groq
WREMOTELY_LOCAL_LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
WREMOTELY_LOCAL_LLM_ENDPOINT=https://api.groq.com/openai/v1
WREMOTELY_LOCAL_LLM_TIMEOUT_SECONDS=60
