wremotely_clickhouse:
  target: dev
  outputs:
    dev:
      type: clickhouse
      schema: "{{ env_var('WREMOTELY_CLICKHOUSE_DATABASE', 'wremotely_dev') }}"
      host: "{{ env_var('WREMOTELY_CLICKHOUSE_HOST', '127.0.0.1') }}"
      port: "{{ env_var('WREMOTELY_CLICKHOUSE_PORT', '8123') | int }}"
      user: "{{ env_var('WREMOTELY_CLICKHOUSE_USER', 'wremotely_dev') }}"
      password: "{{ env_var('WREMOTELY_CLICKHOUSE_PASSWORD', '') }}"
      secure: false
      threads: 1
